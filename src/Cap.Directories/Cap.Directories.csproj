<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cap.Directories</RootNamespace>
    <Description>Well-known project directories (config, data, cache, state) returned as Dir capabilities rather than strings.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cap.Std/Cap.Std.csproj" PrivateAssets="none" />
    <!-- Cap.Primitives ships inside Cap.Std, and Cap.Std carries the analyzer on to whoever
         installs this package. Both are explained in Cap.Std.csproj. -->
    <ProjectReference Include="../Cap.Primitives/Cap.Primitives.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cap.Directories.Tests" />
  </ItemGroup>

</Project>
