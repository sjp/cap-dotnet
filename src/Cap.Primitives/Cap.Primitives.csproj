<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cap.Primitives</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Internal path parsing, platform interop and sandboxed resolution algorithms for cap-dotnet. Not intended to be referenced directly.</Description>
    <!-- Adds build/CapBannedSymbols.Primitives.txt on top of the ambient-authority rules. -->
    <CapBanSystemIoPath>true</CapBanSystemIoPath>
    <!-- Shipped inside the Cap.Std package, never as a package of its own; see Cap.Std.csproj. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Cap.Primitives has (deliberately) almost no public surface: the resolution
      algorithms are internal and reached through these assemblies only.
    -->
    <InternalsVisibleTo Include="Cap.Std" />
    <InternalsVisibleTo Include="Cap.Fs.Ext" />
    <InternalsVisibleTo Include="Cap.Net" />
    <InternalsVisibleTo Include="Cap.Time" />
    <InternalsVisibleTo Include="Cap.Rand" />
    <InternalsVisibleTo Include="Cap.Directories" />
    <InternalsVisibleTo Include="Cap.Std.Testing" />
    <InternalsVisibleTo Include="Cap.Primitives.Tests" />
    <InternalsVisibleTo Include="Cap.Std.Tests" />
    <InternalsVisibleTo Include="Cap.Escape.Tests" />
    <InternalsVisibleTo Include="Cap.Escape.Aot.Tests" />
    <InternalsVisibleTo Include="Cap.Fs.Ext.Tests" />
    <InternalsVisibleTo Include="Cap.Stress.Tests" />
    <InternalsVisibleTo Include="Cap.Benchmarks" />
    <InternalsVisibleTo Include="Cap.Fuzz" />
    <InternalsVisibleTo Include="Cap.Fuzz.Tests" />
    <InternalsVisibleTo Include="WasiHost.Tests" />
  </ItemGroup>

</Project>
