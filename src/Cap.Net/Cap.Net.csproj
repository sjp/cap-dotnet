<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cap.Net</RootNamespace>
    <Description>Capability-based sockets. See 0019 -- this is deliberately the least-settled part of the port.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unix domain sockets are named by a filesystem path, so they are a Dir capability,
         not a Pool capability. That is why this references Cap.Std. See 0019. -->
    <ProjectReference Include="../Cap.Std/Cap.Std.csproj" />
  </ItemGroup>

</Project>
