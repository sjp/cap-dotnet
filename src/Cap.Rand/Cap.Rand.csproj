<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cap.Rand</RootNamespace>
    <Description>Randomness capabilities: the operating system's cryptographic generator, handed out only against an AmbientAuthority token, and a seeded sequence for tests that cannot be mistaken for it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Nothing here uses Cap.Std itself. The types this assembly needs are in Cap.Primitives,
      which ships inside the Cap.Std package rather than as one of its own (see Cap.Std.csproj),
      so Cap.Std is the dependency that brings them, and the analyzer with them
      (PrivateAssets="none"; see Cap.Std.csproj).
    -->
    <ProjectReference Include="../Cap.Std/Cap.Std.csproj" PrivateAssets="none" />
    <ProjectReference Include="../Cap.Primitives/Cap.Primitives.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
