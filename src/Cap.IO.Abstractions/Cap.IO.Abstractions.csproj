<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cap.IO.Abstractions</RootNamespace>
    <Description>An IFileSystem from System.IO.Abstractions whose every path is resolved beneath a Dir, so code written against IFileSystem gets containment by changing the composition root rather than the component.</Description>
    <PackageTags>$(PackageTags);System.IO.Abstractions;IFileSystem;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cap.Std/Cap.Std.csproj" PrivateAssets="none" />
    <ProjectReference Include="../Cap.Fs.Ext/Cap.Fs.Ext.csproj" PrivateAssets="none" />
    <!-- Cap.Primitives ships inside Cap.Std, and Cap.Std carries the analyzer on to whoever
         installs this package. Both are explained in Cap.Std.csproj. -->
    <ProjectReference Include="../Cap.Primitives/Cap.Primitives.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The only third-party runtime dependency in any package here. The interfaces this assembly
    implements are declared in Testably.Abstractions.FileSystem.Interface, which
    TestableIO.System.IO.Abstractions depends on and forwards to, so both are referenced
    directly. Directory.Packages.props gives each a minimum, the versions this assembly is
    built against, and no maximum. Their maintainers add members to the interfaces in minor
    releases, and beside a newer interface assembly with a member this one lacks,
    DirFileSystem fails to load, with TypeLoadException, when it is constructed. That is loud
    and immediate, and it is what every other IFileSystem implementation accepts; capping the
    range instead would refuse the whole package to any project that has the newer version.
    The io-abstractions-latest job in .github/workflows/ci.yml builds and tests against the
    newest stable versions, so a new member is found here before a release.

    The Wrappers package, which holds the ambient FileSystem over the static System.IO types,
    is deliberately not referenced: a containment package has no business shipping the thing
    it exists to replace.
  -->
  <ItemGroup>
    <PackageReference Include="TestableIO.System.IO.Abstractions" />
    <PackageReference Include="Testably.Abstractions.FileSystem.Interface" />
  </ItemGroup>

  <!--
    The members of System.IO.Path that are string functions are used here to give IPath the
    platform's behaviour. The members that consult the host, or that fold `..` away as text,
    are banned; see the notes in the file.
  -->
  <ItemGroup>
    <AdditionalFiles Include="CapBannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cap.IO.Abstractions.Tests" />
  </ItemGroup>

</Project>
