<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cap.Std</RootNamespace>
    <Description>Capability-based filesystem API for .NET: Dir, CapFile, CapMetadata. A Dir handle is the authority; there is no ambient path lookup.</Description>
    <!--
      This assembly turns a caller's string into a resolution against a directory handle, so
      it is subject to the same ban on System.IO.Path as the layer beneath it.
    -->
    <CapBanSystemIoPath>true</CapBanSystemIoPath>
  </PropertyGroup>

  <!--
    Cap.Primitives ships inside this package, in lib/ beside Cap.Std.dll, and not as a package
    of its own. Its few public types (AmbientAuthority, CapPath, SymlinkPolicy and the like)
    are part of the API every package here shares, but the assembly is not a separate thing to
    depend on or version: a package ID is a promise, and this one would promise a layer whose
    shape is expected to change.

    PrivateAssets="all" keeps it out of this package's dependency list, and also stops it
    flowing on to projects that reference this one. So every project in the repository that
    uses a type from it, including the other packages, references it directly. That is the
    same view a package consumer gets: they receive the assembly with Cap.Std.

    The other packages reference Cap.Std with PrivateAssets="none". NuGet's default for a
    project reference would write the dependency as exclude="Build,Analyzers", so a project
    that installed only Cap.Time, say, would get Cap.Std's types without its analyzer.
  -->
  <ItemGroup>
    <ProjectReference Include="../Cap.Primitives/Cap.Primitives.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCapPrimitivesInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeCapPrimitivesInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <CapPrimitivesAssembly Include="@(ReferencePath)"
                             Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferencePath.Filename)' == 'Cap.Primitives'" />
      <BuildOutputInPackage Include="@(CapPrimitivesAssembly)" />
      <BuildOutputInPackage Include="@(CapPrimitivesAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
    <Error Condition="'@(CapPrimitivesAssembly)' == ''" Text="Cap.Primitives was not found among Cap.Std's references, so it cannot be packed inside Cap.Std." />
  </Target>

  <!--
    The analyzer travels in this package rather than in one of its own, so that a project
    that takes a Dir also gets the rules about reaching around one. It is already built as
    part of this project, because every assembly under src/ is analysed by it; packing only
    has to pick the assembly up and place it where NuGet looks for analyzers.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeCapAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="IncludeCapAnalyzerInPackage">
    <MSBuild Projects="../Cap.Analyzers/Cap.Analyzers.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="CapAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(CapAnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Cap.Fs.Ext" />
    <InternalsVisibleTo Include="Cap.Net" />
    <InternalsVisibleTo Include="Cap.Directories" />
    <InternalsVisibleTo Include="Cap.Std.Tests" />
    <InternalsVisibleTo Include="Cap.Escape.Tests" />
    <InternalsVisibleTo Include="Cap.Escape.Aot.Tests" />
    <InternalsVisibleTo Include="Cap.Stress.Tests" />
    <InternalsVisibleTo Include="Cap.Benchmarks" />
  </ItemGroup>

</Project>
