<Project>

  <!--
    The ambient-authority ban on this library's own assemblies, enforced by the analyzer that
    ships to consumers in the Cap.Std package. The rules it leaves off for consumers are made
    errors for src/ in .editorconfig: nothing here may reach the filesystem, the network, the
    clock or entropy except through the capability that stands for it.

    build/CapBannedSymbols.Primitives.txt  additionally bans System.IO.Path, which silently
    rewrites paths (lexical `..` collapsing, Windows trailing-dot stripping) and is therefore
    unusable for containment decisions. It applies to the assemblies that resolve names,
    which set CapBanSystemIoPath.
  -->
  <ItemGroup Condition="'$(CapIsProductCode)' == 'true' and '$(MSBuildProjectName)' != 'Cap.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Cap.Analyzers/Cap.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build/CapBannedSymbols.Primitives.txt"
                     Condition="'$(CapBanSystemIoPath)' == 'true'" />
  </ItemGroup>

  <!--
    Tells the analyzer which assemblies are this library's own. CAP0004 and CAP0005 are about
    members of this library, and an assembly name is no way to tell: a consumer may call its
    own assemblies Cap.Something. Every product assembly but the analyzer references
    Cap.Primitives, where the attribute is declared.
  -->
  <ItemGroup Condition="'$(CapIsProductCode)' == 'true' and '$(MSBuildProjectName)' != 'Cap.Analyzers'">
    <AssemblyAttribute Include="Cap.Primitives.CapabilityLibraryAttribute" />
  </ItemGroup>

  <!--
    System.IO.Abstractions is a runtime dependency of Cap.IO.Abstractions and of nothing else
    that ships. Every other package depends on .NET alone, and a reference added to one of
    them by habit would quietly make that untrue for everyone who installs it.
  -->
  <Target Name="CapRestrictSystemIoAbstractions"
          BeforeTargets="CollectPackageReferences"
          Condition="'$(CapIsProductCode)' == 'true' and '$(MSBuildProjectName)' != 'Cap.IO.Abstractions'">
    <Error Condition="'@(PackageReference->AnyHaveMetadataValue('Identity', 'TestableIO.System.IO.Abstractions'))' == 'true' or '@(PackageReference->AnyHaveMetadataValue('Identity', 'Testably.Abstractions.FileSystem.Interface'))' == 'true'"
           Text="$(MSBuildProjectName) references System.IO.Abstractions, which only Cap.IO.Abstractions may depend on." />
  </Target>

</Project>
