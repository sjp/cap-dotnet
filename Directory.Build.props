<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Trimming / AOT. Every shipping assembly must stay analysable. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!--
    Deterministic, source-linked builds. The PDB is embedded in each assembly rather than
    published as a separate symbol package: Cap.Primitives travels inside the Cap.Std package,
    and an embedded PDB goes wherever its assembly goes, so there is no second file to keep in
    step with it and a debugger finds the sources through SourceLink without a symbol server.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Directory-scoped defaults. `CapIsProductCode` marks the assemblies that are subject to
    the ambient-authority ban; tests, benchmarks and samples deliberately use ambient
    System.IO in order to *set up* the scenarios they then attack.
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <CapIsProductCode>true</CapIsProductCode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CapIsProductCode)' != 'true'">
    <IsPackable>false</IsPackable>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package metadata. Versions follow SemVer and stay at 0.x until the escape corpus has held
    across a release and the API has had an external review; docs/releasing.md has the policy.
    A release sets the version from its tag. The prefix here only names local builds.
  -->
  <PropertyGroup Condition="'$(CapIsProductCode)' == 'true'">
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
    <Authors>cap-dotnet contributors</Authors>
    <Product>cap-dotnet</Product>
    <Copyright>Copyright (c) cap-dotnet contributors</Copyright>
    <PackageProjectUrl>https://github.com/sjp/cap-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sjp/cap-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>capability;security;sandbox;filesystem;path-traversal;cap-std</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(CapIsProductCode)' == 'true' and '$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)build/package/README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
