root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.cs]
# --- Usings / namespaces -------------------------------------------------------------
csharp_using_directive_placement = outside_namespace:warning
dotnet_style_namespace_match_folder = true:warning
csharp_style_namespace_declarations = file_scoped:warning

# --- Modifiers and readonly ----------------------------------------------------------
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning

# --- Expression preferences ----------------------------------------------------------
csharp_style_var_elsewhere = false:silent
csharp_style_prefer_pattern_matching = true:warning
csharp_prefer_braces = true:warning


# --- Trimming / AOT ------------------------------------------------------------------
# These are errors in product code because a suppression is a design decision,
# not a build annoyance.
dotnet_diagnostic.IL2026.severity = error
dotnet_diagnostic.IL2091.severity = error
dotnet_diagnostic.IL3050.severity = error

# --- Interop -------------------------------------------------------------------------
# SYSLIB1054: use [LibraryImport] rather than [DllImport]. Source-generated marshalling is
# the only AOT-safe option and it is what the interop layer assumes throughout.
dotnet_diagnostic.SYSLIB1054.severity = error
# CA1416: platform-compatibility. Cap.Primitives is full of per-OS code paths and every
# one of them must be guarded, not assumed.
dotnet_diagnostic.CA1416.severity = error

# --- Deliberately relaxed ------------------------------------------------------------
# CA1031: we do catch broadly in a few places (handle cleanup) on purpose.
dotnet_diagnostic.CA1031.severity = suggestion
# CA1707: interop declarations mirror C names (open_how, RESOLVE_BENEATH) verbatim so they
# can be diffed against the kernel headers.
dotnet_diagnostic.CA1707.severity = none

[tests/**/*.cs]
# Test method names read as sentences.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2007.severity = none

[bench/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

[tests/**/*.cs]
# Shared guard files are linked into every test project, so folder and namespace differ.
dotnet_diagnostic.IDE0130.severity = none

[src/**.cs]
# --- Ambient authority ---------------------------------------------------------------
# The library's own assemblies reach nothing except through the capability that stands for
# it. These rules are off for consumers until they opt in; here they are errors, not
# warnings, because a warning would be routinely ignored and the ban would rot. The few
# places that are allowed to reach the real thing -- where the clock, entropy and sockets
# enter, behind a token or a pool check -- suppress the rule at that line and say why.
dotnet_diagnostic.CAP0001.severity = error
dotnet_diagnostic.CAP0002.severity = error
dotnet_diagnostic.CAP0006.severity = error
dotnet_diagnostic.CAP0007.severity = error
dotnet_diagnostic.CAP0008.severity = error
