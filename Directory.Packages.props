<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Microsoft.CodeAnalysis.CSharp is the compiler API Cap.Analyzers.dll is built against, and a
    compiler loads an analyzer only when the version it references is no newer than its own;
    otherwise it reports CS9057 and runs the build without it. So this is the oldest compiler the
    analyzer supports, not the newest one available: 5.0.0 is the Roslyn in SDK 10.0.100, the
    first SDK that can consume a net10.0 package. Raise it only together with the floor stated
    in docs/analyzers.md and the oldest SDK the analyzer-package CI job builds a consumer with;
    dependabot is told to leave it alone (.github/dependabot.yml). The analyzer tests compile
    against the same version, so they also show the analyzer works on that API.
    Microsoft.CodeAnalysis.Analyzers checks the analyzer's source at build time and is not
    referenced by the shipped assembly, so it can stay current.
  -->
  <ItemGroup Label="Analyzer authoring and testing (Cap.Analyzers)">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
  </ItemGroup>

  <!--
    The interfaces Cap.IO.Abstractions implements, and the only third-party runtime dependency
    of any package. Minimums rather than one minor version each, so that a consumer can install
    a newer one beside the package; see src/Cap.IO.Abstractions/Cap.IO.Abstractions.csproj.
    Raise both together, along with the test doubles below, and only once the adapter
    implements every member the new minimum declares.
  -->
  <ItemGroup Label="Runtime (Cap.IO.Abstractions only)">
    <PackageVersion Include="TestableIO.System.IO.Abstractions" Version="[22.3.0,)" />
    <PackageVersion Include="Testably.Abstractions.FileSystem.Interface" Version="[10.4.0,)" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.aot.mtp-off" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions.TestingHelpers" Version="22.3.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.3.0" />
    <PackageVersion Include="Testably.Abstractions" Version="10.4.0" />
  </ItemGroup>

  <ItemGroup Label="Fuzzing">
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Samples">
    <PackageVersion Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>

  <ItemGroup Label="Benchmarking">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
