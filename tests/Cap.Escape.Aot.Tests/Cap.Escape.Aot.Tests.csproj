<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The escape corpus, compiled from the same sources as Cap.Escape.Tests but against xunit's
    ahead-of-time packages, so that it can be published the ways an application ships and run
    as the binary that comes out. The guarantee is in how the library behaves once it has been
    compiled to native code or had its unused parts trimmed away, and only running the corpus
    against that output shows the behaviour survived; a clean publish shows only that it linked.

    The shape of the publish is chosen with CapPublishAs rather than with the SDK's own
    properties on the command line, because those would be passed on to every referenced
    project, the analyzer among them, and it targets netstandard2.0, which can be neither
    compiled ahead of time nor trimmed:

      native       (default)  NativeAOT: one native executable, no JIT, no IL at run time.
      single-file             Self-contained, trimmed and bundled into one file, run on the JIT.

    Not run by `dotnet test`: under the JIT it is the same suite Cap.Escape.Tests already runs.
    It is published and run by the NativeAOT jobs in CI; see docs/aot.md.
  -->
  <PropertyGroup>
    <AssemblyName>Cap.Escape.Aot.Tests</AssemblyName>
    <RootNamespace>Cap.Escape.Tests</RootNamespace>
    <CapUsesScratchTree>true</CapUsesScratchTree>
    <CapRunsEachBackend>true</CapRunsEachBackend>
    <CapXunitAot>true</CapXunitAot>
    <DefineConstants>$(DefineConstants);CAP_XUNIT_AOT</DefineConstants>
    <IsTestProject>false</IsTestProject>
    <!--
      The ordinary xunit package suppresses this rule on test methods, which must be instance
      methods for the framework; the suppressor does not recognise the ahead-of-time package's
      attributes, so the same sources that are clean in Cap.Escape.Tests would fail here.
    -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <CapPublishAs Condition="'$(CapPublishAs)' == ''">native</CapPublishAs>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CapPublishAs)' == 'native'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CapPublishAs)' == 'single-file'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <!--
    A trim or AOT warning means the compiler could not prove some code is still reachable, and
    code it cannot prove reachable may be missing from the binary. Such a warning fails the
    publish rather than leaving the run to find out which.
  -->
  <PropertyGroup>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cap.Std/Cap.Std.csproj" />
    <ProjectReference Include="../../src/Cap.Primitives/Cap.Primitives.csproj" />
    <ProjectReference Include="../../src/Cap.Fs.Ext/Cap.Fs.Ext.csproj" />
    <ProjectReference Include="../../src/Cap.Std.Testing/Cap.Std.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Cap.Escape.Tests/*.cs" Link="Corpus/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/threat-model.md" LogicalName="threat-model.md" />
  </ItemGroup>

</Project>
