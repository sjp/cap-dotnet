<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- xunit v3 test projects are self-executing. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      The source-generated marshalling that [LibraryImport] emits is built on pointers, so
      it does not compile without this. Required because SYSLIB1054 is an error repo-wide:
      the shared privilege guard has to read the process token through Win32, and
      [DllImport] is not an option.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      No InvariantGlobalization here, and none in the root props either: the macOS
      normalization cases in the escape tests need real ICU. Turning it on would make
      String.Normalize misbehave and the tests would pass for the wrong reason.
    -->
  </PropertyGroup>

  <!--
    A project that sets CapXunitAot is built against xunit's ahead-of-time packages, which
    discover tests through a source generator instead of reflection, so the same test sources
    can be published with NativeAOT and trimming. The few places a test source has to differ
    between the two builds test for CAP_XUNIT_AOT, which such a project defines. The coverage
    collector instruments IL at run time and has nothing to instrument in a native binary, so
    it is left out.
  -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Condition="'$(CapXunitAot)' != 'true'" />
    <PackageReference Include="xunit.v3.aot.mtp-off" Condition="'$(CapXunitAot)' == 'true'" />
    <!-- Self-registers into the MTP host; it must stay a normal compile-time reference. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Condition="'$(CapXunitAot)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Guards that must hold in every test assembly. See tests/Shared. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs"
             Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The throwaway directory in tests/Scenarios, for suites that need a real tree to attack
    rather than a simulated one. Opt-in, because it is built on Cap.Std and so only compiles
    where that assembly is referenced. The namespace is imported for every file in such a
    project, so a test refers to it without saying where it came from.
  -->
  <ItemGroup Condition="'$(CapUsesScratchTree)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Scenarios/*.cs"
             Link="Scenarios/%(Filename)%(Extension)" />
    <Using Include="Cap.Testing" />
  </ItemGroup>

  <!--
    The switch in tests/Backends that makes each resolution backend this host has the one every
    handle dispatches to, in turn, so that a suite runs against the kernel's confined open and
    the name-at-a-time walk from one process. Opt-in, because it reaches into Cap.Primitives
    internals and so only compiles where that assembly has granted access.
  -->
  <ItemGroup Condition="'$(CapRunsEachBackend)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Backends/*.cs"
             Link="Backends/%(Filename)%(Extension)" />
    <Using Include="Cap.Testing" Condition="'$(CapUsesScratchTree)' != 'true'" />
  </ItemGroup>

  <!--
    The simulated filesystem in tests/Fakes. Opt-in rather than shared by every assembly,
    because it implements an internal contract of Cap.Primitives and so only compiles where
    that assembly has granted access. A project that needs it sets CapUsesPlatformFake.
    It is built on the node tree and confined resolution in Cap.Std.Testing, which grants
    such a project access to them.
  -->
  <ItemGroup Condition="'$(CapUsesPlatformFake)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Fakes/*.cs"
             Link="Fakes/%(Filename)%(Extension)" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Cap.Std.Testing/Cap.Std.Testing.csproj" />
  </ItemGroup>

</Project>
