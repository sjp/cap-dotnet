<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cap.Primitives.Tests</RootNamespace>
    <AssemblyName>Cap.Primitives.Tests</AssemblyName>
    <!-- Brings in tests/Fakes: the simulated filesystem the resolution tests run against. -->
    <CapUsesPlatformFake>true</CapUsesPlatformFake>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cap.Primitives/Cap.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The check a suite makes on leaving a backend, so that BackendScopeTests can make it fail. -->
    <Compile Include="../Backends/Backends.cs" Link="Backends/Backends.cs" />
  </ItemGroup>

</Project>
