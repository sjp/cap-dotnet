<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cap.Escape.Tests</RootNamespace>
    <AssemblyName>Cap.Escape.Tests</AssemblyName>
    <!-- The throwaway directory in tests/Scenarios, placed wherever the run was told to. -->
    <CapUsesScratchTree>true</CapUsesScratchTree>
    <!-- Can run with a filesystem held in memory in place of the host; see tests/InMemory. -->
    <CapRunsInMemory>true</CapRunsInMemory>
    <!-- Every backend this host has, substituted in turn for the length of one case. -->
    <CapRunsEachBackend>true</CapRunsEachBackend>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cap.Std/Cap.Std.csproj" />
    <ProjectReference Include="../../src/Cap.Primitives/Cap.Primitives.csproj" />
    <ProjectReference Include="../../src/Cap.Fs.Ext/Cap.Fs.Ext.csproj" />
    <ProjectReference Include="../../src/Cap.Std.Testing/Cap.Std.Testing.csproj" />
  </ItemGroup>

  <!--
    The threat model, carried alongside the tests so that the suite can check it defends
    every row the document says is defended. A copy rather than a path back into the source
    tree, because the tests must run wherever the binaries were copied to.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../docs/threat-model.md" LogicalName="threat-model.md" />
  </ItemGroup>

  <!--
    Every test source in the repository, carried so that the suite can check that each test
    and corpus case the threat model names still exists. Read as text rather than loaded as
    assemblies: the other test projects are not referenced from here, and the check must run
    wherever the binaries were copied to, including the native-AOT build of this corpus.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../**/*.cs"
                      Exclude="../**/bin/**/*.cs;../**/obj/**/*.cs"
                      LogicalName="TestSource.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
