<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cap.Std.Tests</RootNamespace>
    <AssemblyName>Cap.Std.Tests</AssemblyName>
    <!--
      The simulated filesystem. Some of what the public layer promises is only observable
      against a platform a test can drive: what a creation asks the system for, what happens
      when a removal is refused by the object itself, and both answers to "can this system
      make a file with no name". A real machine gives one answer to each.
    -->
    <CapUsesPlatformFake>true</CapUsesPlatformFake>
    <!-- The throwaway directory in tests/Scenarios. -->
    <CapUsesScratchTree>true</CapUsesScratchTree>
    <!-- Can run with a filesystem held in memory in place of the host; see tests/InMemory. -->
    <CapRunsInMemory>true</CapRunsInMemory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cap.Std/Cap.Std.csproj" />
    <ProjectReference Include="../../src/Cap.Primitives/Cap.Primitives.csproj" />
  </ItemGroup>

  <!--
    The rest of the shipped libraries, referenced only so that the audit of who reads the
    host backend can load them and read their code. Nothing here calls into them.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Cap.Directories/Cap.Directories.csproj" />
    <ProjectReference Include="../../src/Cap.Fs.Ext/Cap.Fs.Ext.csproj" />
    <ProjectReference Include="../../src/Cap.Net/Cap.Net.csproj" />
    <ProjectReference Include="../../src/Cap.Rand/Cap.Rand.csproj" />
    <ProjectReference Include="../../src/Cap.Time/Cap.Time.csproj" />
  </ItemGroup>

  <!--
    The Cap.Std sources, carried into this assembly so that a test can read them.

    One of the guarantees this library makes is not expressible as behaviour: that no
    operation ever rebuilds a path out of pieces. A test can only observe the results of the
    code, and a rebuilt path produces the right result nearly every time, and goes wrong
    only against a tree an attacker has arranged. So the property is asserted about the
    source instead, which needs the source at run time.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../src/Cap.Std/**/*.cs"
                      Exclude="../../src/Cap.Std/obj/**/*.cs;../../src/Cap.Std/bin/**/*.cs"
                      LogicalName="CapStdSource.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
